{
  "name": "ai-village",
  "version": "0.1.0",
  "private": true,
  "description": "Animated, local-first command center for monitoring real AI agent activity.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:hub": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.ts",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/install-hooks.mjs --uninstall",
    "hub": "node --disable-warning=ExperimentalWarning server/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "fastify": "^5.12.7",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.65.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "bin": {
    "ai-village": "scripts/start.mjs"
  },
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "monitoring",
    "claude-code",
    "gemini-cli",
    "dashboard",
    "three.js",
    "local-first"
  ]
}
